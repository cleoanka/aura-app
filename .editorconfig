# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Rust — rustfmt defaults (4-space indent, 100-col width)
[*.rs]
indent_size = 4

# Python — PEP 8 (4-space indent)
[*.py]
indent_size = 4

# Go — tabs are canonical
[*.go]
indent_style = tab

# Markdown — trailing whitespace can be a hard line break; don't trim
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs
[Makefile]
indent_style = tab
